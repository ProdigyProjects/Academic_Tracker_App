<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp"
    android:background="#FFFFFF"> <!-- White background -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Data Analytics and Insights"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:paddingBottom="16dp" />

        <!-- Section: Total Study Hours -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            app:cardBackgroundColor="#F5F5F5"> <!-- Use app:cardBackgroundColor -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp">

                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Study Hours"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="#000000" /> <!-- Black text -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20 hours this week"
                        android:textSize="14sp"
                        android:textColor="#000000" /> <!-- Black text -->

                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Section: Average Study Time -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            app:cardBackgroundColor="#F5F5F5"> <!-- Use app:cardBackgroundColor -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Average Study Time"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#000000" /> <!-- Black text -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3h/Day"
                    android:textSize="14sp"
                    android:textColor="#000000" /> <!-- Black text -->

                <ProgressBar
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:progress="60"
                    android:progressTint="#000000"
                    android:indeterminateTint="#000000" /> <!-- Black indeterminate color -->
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Section: Tasks Completed -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            app:cardBackgroundColor="#F5F5F5"> <!-- Use app:cardBackgroundColor -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tasks Completed"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#000000" /> <!-- Black text -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="80%"
                    android:textSize="14sp"
                    android:textColor="#000000" /> <!-- Black text -->

                <ProgressBar
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:progress="80"
                    android:progressTint="#000000"
                    android:indeterminateTint="#000000" /> <!-- Black indeterminate color -->
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Section: Progress Goals -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            app:cardBackgroundColor="#F5F5F5"> <!-- Use app:cardBackgroundColor -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Progress Goals"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#000000" /> <!-- Black text -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You are 60% towards completing all of your study goals"
                    android:textSize="14sp"
                    android:textColor="#000000" /> <!-- Black text -->

                <ProgressBar
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:progress="60"
                    android:progressTint="#000000"
                    android:indeterminateTint="#000000" /> <!-- Black indeterminate color -->
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Add other sections similarly with black and white colors -->

    </LinearLayout>
</ScrollView>
