<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.example.academictrackerapp.prisca.controller.PraiseFragment">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#f2f2f2"
        android:padding="17dp"
        android:orientation="horizontal">
        <!-- You can add header elements here if needed -->
    </LinearLayout>

    <!-- Achievement Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:padding="16dp"
        android:orientation="vertical"
        android:layout_marginTop="70dp">

        <!-- Status Bar -->
        <LinearLayout
            android:id="@+id/status_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">
            <LinearLayout
                android:id="@+id/status_icons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <!-- Add status icons here -->
            </LinearLayout>
        </LinearLayout>

        <!-- Achievement Title -->
        <TextView
            android:id="@+id/achievement_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Goal Achieved!"
            android:textColor="@android:color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            android:gravity="center" />

        <!-- Achievement Description -->
        <TextView
            android:id="@+id/achievement_description"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="33dp"
            android:gravity="center"
            android:text="You have successfully achieved your goal. Keep up the incredible effort!"
            android:textColor="#7D7D7D"
            android:textSize="16sp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#A39797"
            android:layout_marginTop="161dp" />

        <RelativeLayout
            android:gravity="center"
            android:background="@color/white"
            android:layout_height="100dp"
            android:layout_width="match_parent">

            <TextView
                android:id="@+id/congratulationsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Congratulations!"
                android:textSize="32sp"
                android:textColor="@color/primaryColor"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/confettiImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_confetti"
                android:contentDescription="Confetti_image_desc"
                android:visibility="gone" />

        </RelativeLayout>

        <!-- Confirm Button -->
        <Button
            android:id="@+id/confirm_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@android:color/black"
            android:text="OK, Sure!"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:padding="13dp" />

    </LinearLayout>

</FrameLayout>