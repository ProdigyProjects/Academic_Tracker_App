<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"
    tools:context=".katiana.materialMarketplace.MaterialMarketplace">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="15dp"
        android:orientation="vertical">

        <!-- Header with Search and Filter Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start">

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="240dp"
                android:autofillHints="name"
                android:hint="Search for study materials"
                android:inputType="textPersonName"
                android:layout_height="40dp"
                android:background="@drawable/edit_text_background"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:padding="8dp"/>

            <ImageButton
                android:id="@+id/btn_search"
                android:layout_width="50dp"
                android:layout_height="40dp"
                android:background="@drawable/button_background"
                android:layout_marginLeft="10dp"
                android:src="@drawable/search_icon"
                android:scaleType="center" />
        </LinearLayout>

        <!-- Description Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Find notes, flashcards, and more"
            android:textSize="14sp"/>

        <!-- Available Flashcards Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Available Flashcards"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:layout_marginTop="16dp"/>

        <!-- Flashcards Grid Section -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            android:layout_margin="1dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_margin="5dp"
                android:padding="16dp">

                <!-- Grid of Flashcards -->
                <GridLayout
                    android:id="@+id/gridLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="2"
                    android:orientation="horizontal"
                    android:layout_gravity="center"
                    android:padding="8dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- "Create Content" Button Section -->
        <Button
            android:id="@+id/btn_create_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Content"
            android:layout_marginTop="20dp"
            android:background="@drawable/button_background"
            android:textColor="@android:color/white"
            android:padding="16dp"
            android:layout_gravity="center"/>

    </LinearLayout>
</ScrollView>
