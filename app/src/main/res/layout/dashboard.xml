<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="58dp"
    android:padding="8dp"
    tools:context=".katiana.dashboard.Dashboard">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical">

            <!-- Text Content -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <!-- Goals Achieved Section -->
                <TextView
                    android:id="@+id/goalsAchievedTitle"
                    android:layout_width="130dp"
                    android:layout_height="wrap_content"
                    android:text="Goals Achieved"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:paddingBottom="4dp"/>
            </LinearLayout>

            <!-- Progress Bar with Label -->
            <RelativeLayout
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <!-- Progress Bar Background -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:background="#BDBDBD"/>

                <!-- Progress Bar Fill -->
                <View
                    android:layout_width="150dp"
                    android:layout_height="24dp"
                    android:background="#424242"/>

                <!-- Label for Progress -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="9 of 10"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>
            </RelativeLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/progressText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Progress: 80%"
            android:textSize="14sp"/>
        <!-- Progress Overview Section -->
        <LinearLayout
            android:id="@+id/progressOverviewTitleBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/progressOverviewTitle"
                android:layout_width="190dp"
                android:layout_height="40dp"
                android:paddingTop="5dp"
                android:text="Progress Overview"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/moreProgress"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:backgroundTint="@color/primaryColor"
                android:text="View More"
                android:textColor="@android:color/white" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="8dp"
                android:layout_margin="4dp"
                android:elevation="2dp">

                <TextView
                    android:id="@+id/completionRateTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Completion Rate"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/completionRateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="80%"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/completionRateChange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+5% from last week"
                    android:textSize="12sp"
                    android:textColor="#FF5722"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="8dp"
                android:layout_margin="4dp"
                android:elevation="2dp">

                <TextView
                    android:id="@+id/studyTimeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Study Time"
                    android:textSize="14sp"/>

                <TextView
                    android:id="@+id/studyTimeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="20 hours"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

            </LinearLayout>
        </LinearLayout>

        <!-- Content Improvement Section -->
        <TextView
            android:id="@+id/contentImprovementTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Marks Improvement"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="16dp"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="8dp"
                android:layout_margin="4dp"
                android:elevation="2dp">


                <ImageView
                    android:layout_width="150dp"
                    android:layout_height="80dp"
                    android:src="@drawable/biology" />

                <TextView
                    android:id="@+id/algebraPracticeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Algebra Practice"
                    android:textSize="14sp"
                    android:gravity="center"/>

                <!-- First Item -->
                <LinearLayout
                    android:id="@+id/improvementBox1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:gravity="center_vertical">

                    <!-- Text Content -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">
                        <TextView
                            android:id="@+id/algebraPracticeScore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="50%"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- Placeholder for fire icon -->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/fire" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="8dp"
                android:layout_margin="4dp"
                android:elevation="2dp">

                <ImageView
                    android:layout_width="150dp"
                    android:layout_height="80dp"
                    android:src="@drawable/history" />

                <TextView
                    android:id="@+id/chemistryConceptsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chemistry Concepts"
                    android:textSize="14sp"
                    android:gravity="center"/>


                <!-- First Item -->
                <LinearLayout
                    android:id="@+id/improvementBox2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:gravity="center_vertical">

                    <!-- Text Content -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="8dp">
                        <TextView
                            android:id="@+id/algebraPracticeScore2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="50%"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- Placeholder for fire icon -->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/fire" />

                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_margin="4dp"
            android:layout_marginTop="16dp"
            android:elevation="2dp">

            <!-- Personalized Insights Section -->
            <TextView
                android:id="@+id/personalizedInsightsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Personalized Insights"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/insightsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• You're most productive on weekdays after 4 PM.\n• You’ve improved in Math by 10% this month."
                android:textSize="14sp"
                android:paddingTop="8dp"/>

            <!-- Recommendations Section -->
            <TextView
                android:id="@+id/recommendationsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recommendations"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingTop="16dp"/>

            <TextView
                android:id="@+id/recommendationsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• Focus more on Math for the next 3 days to boost performance\n• Consider scheduling more study time for English to balance your subjects"
                android:textSize="14sp"
                android:paddingTop="8dp"/>
        </LinearLayout>

        <!-- Study Recommendations Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:orientation="vertical"
            android:background="@android:color/white">

            <!-- Header with title and "View All" button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="Study Recommendations"
                    android:textStyle="bold"
                    android:textSize="18sp"/>

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"/>

            <!-- First Item -->
            <LinearLayout
                android:id="@+id/recommendations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:gravity="center_vertical">

                <!-- Icon -->
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/maths" />

                <!-- Text Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chemistry"
                        android:textColor="@android:color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Covers key concepts in Chemistry"
                        android:textColor="#808080"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Price and Icons -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="45min"
                    android:textSize="14sp"
                    android:textColor="@android:color/black"
                    android:layout_marginEnd="8dp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0" />

            <!-- Second Item (similar to first item) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:gravity="center_vertical">

                <!-- Icon -->
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/biology" />

                <!-- Text Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Geometry"
                        android:textColor="@android:color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Practice problems on geometric shapes"
                        android:textColor="#808080"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Price and Icons -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25 min"
                    android:textSize="14sp"
                    android:textColor="@android:color/black"
                    android:layout_marginEnd="8dp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0" />

            <!-- Second Item (similar to first item) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:gravity="center_vertical">

                <!-- Icon -->
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/art" />

                <!-- Text Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Material Title"
                        android:textColor="@android:color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Short description"
                        android:textColor="#808080"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Price and Icons -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50min"
                    android:textSize="14sp"
                    android:textColor="@android:color/black"
                    android:layout_marginEnd="8dp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0" />

        </LinearLayout>




        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_margin="4dp"
            android:layout_marginTop="16dp"
            android:elevation="3dp">

            <!-- Historical Insights Section -->
            <TextView
                android:id="@+id/historicalInsightsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Historical Academic Performance"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <!-- Placeholder for Historical Insights Chart -->
            <ImageView
                android:id="@+id/historicalChart"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:src="@drawable/ic_historical_chart"/>

            <TextView
                android:id="@+id/historicalInsightsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Study hours have decreased by 80% compared to block 2."
                android:textSize="14sp"
                android:paddingTop="8dp"/>
        </LinearLayout>

    </LinearLayout>

</ScrollView>