<?xml version="1.0" encoding="utf-8"?>
    <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
    tools:context="com.example.academictrackerapp.prisca.controller.EditGoalFragment">

        <!-- ScrollView to prevent content from being cut off on smaller screens -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Main Content Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Header Bar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/white"
                    android:padding="20dp"
                    android:orientation="horizontal">
                    <!-- Header content can be added here -->
                </LinearLayout>

                <!-- Image Add Section -->
                <LinearLayout
                    android:id="@+id/image_add_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp">

                    <Button
                        android:id="@+id/add_image_button"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:background="@drawable/image"
                        android:drawablePadding="10dp"
                        android:gravity="center"
                        android:padding="10dp"
                        android:text="Add image"
                        android:textColor="@android:color/black" />

                    <ImageView
                        android:id="@+id/added_image"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"
                        android:scaleType="centerCrop" />
                </LinearLayout>

                <!-- Goal Title and Description Section -->
                <LinearLayout
                    android:id="@+id/main_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="19dp">

                    <!-- Label for Goal Title -->
                    <TextView
                        android:id="@+id/goal_title_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="0dp"
                        android:text="Goal Title"
                        android:textColor="@android:color/black"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <!-- EditText for user to enter the goal title -->
                    <EditText
                        android:id="@+id/goal_title_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Enter your goal title"
                        android:padding="10dp"
                        android:textSize="24sp" />

                    <!-- Label for Goal Description -->
                    <TextView
                        android:id="@+id/goal_description_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Description"
                        android:textColor="@android:color/black"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <!-- EditText for user to enter the description -->
                    <EditText
                        android:id="@+id/goal_description_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:hint="Enter your description"
                        android:padding="10dp"
                        android:textSize="24sp" />
                </LinearLayout>

                <!-- Goal Options -->
                <LinearLayout
                    android:id="@+id/goal_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="19dp"
                    android:orientation="horizontal"
                    android:weightSum="3"
                    android:padding="8dp">

                    <!-- Category Section -->
                    <EditText
                        android:id="@+id/goal_category"
                        android:layout_width="0dp"
                        android:layout_height="65dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@color/primaryColor"
                        android:gravity="center"
                        android:hint="Category"
                        android:padding="14dp"
                        android:textColor="@android:color/white"
                        android:textStyle="bold" />

                    <!-- Due Date Section -->
                    <LinearLayout
                        android:id="@+id/due_date_layout"
                        android:layout_width="0dp"
                        android:layout_height="65dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@color/primaryColor"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:id="@+id/calendar_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="Calendar_icon_desc"
                            android:src="@drawable/ic_calendar" />

                        <TextView
                            android:id="@+id/due_date_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Due Date"
                            android:textColor="@android:color/white"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Set Reminder Section -->
                    <LinearLayout
                        android:id="@+id/reminder_layout"
                        android:layout_width="0dp"
                        android:layout_height="67dp"
                        android:layout_weight="1"
                        android:background="@color/primaryColor"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <ImageView
                            android:id="@+id/clock_icon"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:contentDescription="Clock_icon_desc"
                            android:src="@drawable/ic_clock" />

                        <TextView
                            android:id="@+id/reminder_time_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Reminder Time"
                            android:textColor="@android:color/white"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="20dp">

                    <Button
                        android:id="@+id/cancelButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cancel"
                        android:textColor="@android:color/white"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="16dp"
                        android:layout_height="wrap_content" />

                    <Button
                        android:id="@+id/submitButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="OK"
                        android:textColor="@android:color/white"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </FrameLayout>